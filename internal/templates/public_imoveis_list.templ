package templates

import (
	"fmt"
	"github.com/gucardona/imob.app/internal/repo"
)

templ ImovelList(imoveis []repo.Imovel, thumbURLs map[int64]string, filter repo.ImovelFilter, cfg repo.Configuracao) {
	@PublicLayout("Imóveis", cfg) {
		<div class="max-w-7xl mx-auto px-6 py-8">
			<div class="mb-6">
				<h1 class="text-2xl font-bold text-gray-900">Imóveis Disponíveis</h1>
				<p class="text-gray-500 text-sm mt-1">{ fmt.Sprintf("%d", len(imoveis)) } imóvel(eis) encontrado(s)</p>
			</div>
			<div class="flex flex-col lg:flex-row gap-8">
				<!-- Sidebar filters -->
				<aside class="lg:w-64 flex-shrink-0">
					<div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 sticky top-24">
						<h2 class="font-semibold text-gray-900 mb-6">Filtros</h2>
						<form method="GET" action="/imoveis" class="space-y-6">
							<div>
								<label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">
									Finalidade
								</label>
								<select
									name="finalidade"
									onchange="this.form.submit()"
									class="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm text-gray-700 focus:outline-none focus:border-teal-400 focus:ring-1 focus:ring-teal-100 bg-white"
								>
									<option value="" selected?={ filter.Finalidade == "" }>Todos</option>
									<option value="venda" selected?={ filter.Finalidade == "venda" }>Venda</option>
									<option value="aluguel" selected?={ filter.Finalidade == "aluguel" }>Aluguel</option>
								</select>
							</div>
							<div>
								<label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">
									Tipo
								</label>
								<select
									name="tipo"
									onchange="this.form.submit()"
									class="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm text-gray-700 focus:outline-none focus:border-teal-400 focus:ring-1 focus:ring-teal-100 bg-white"
								>
									<option value="" selected?={ filter.Tipo == "" }>Todos os tipos</option>
									<option value="casa" selected?={ filter.Tipo == "casa" }>Casa</option>
									<option value="apartamento" selected?={ filter.Tipo == "apartamento" }>Apartamento</option>
									<option value="terreno" selected?={ filter.Tipo == "terreno" }>Terreno</option>
									<option value="comercial" selected?={ filter.Tipo == "comercial" }>Comercial</option>
									<option value="rural" selected?={ filter.Tipo == "rural" }>Rural</option>
								</select>
							</div>
							<div>
								<label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">
									Cidade
								</label>
								<input
									type="text"
									name="cidade"
									value={ filter.Cidade }
									placeholder="Ex: São Paulo"
									class="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm text-gray-700 focus:outline-none focus:border-teal-400 focus:ring-1 focus:ring-teal-100"
								/>
							</div>
							<button
								type="submit"
								class="w-full bg-teal-600 hover:bg-teal-700 text-white text-sm font-semibold py-2.5 rounded-xl transition-colors"
							>
								Filtrar
							</button>
							if filter.Tipo != "" || filter.Finalidade != "" || filter.Cidade != "" {
								<a
									href="/imoveis"
									class="block w-full text-teal-600 hover:text-teal-700 text-sm text-center py-2 border border-teal-200 rounded-xl hover:bg-teal-50 transition-colors"
								>
									Limpar filtros
								</a>
							}
						</form>
					</div>
				</aside>
				<!-- Card grid -->
				<main class="flex-1 min-w-0">
					if len(imoveis) == 0 {
						<div class="text-center py-20">
							<p class="text-5xl mb-4">🏚</p>
							<p class="text-gray-500">Nenhum imóvel encontrado com esses filtros.</p>
							<a href="/imoveis" class="inline-block mt-4 text-teal-600 hover:underline text-sm">Limpar filtros</a>
						</div>
					} else {
						<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
							for _, im := range imoveis {
								@ImovelCard(im, thumbURLs[im.ID])
							}
						</div>
					}
				</main>
			</div>
		</div>
	}
}
