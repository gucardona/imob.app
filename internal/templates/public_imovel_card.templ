package templates

import (
	"fmt"
	"github.com/gucardona/imob.app/internal/repo"
)

templ ImovelCard(imovel repo.Imovel, thumbURL string) {
	<a
		href={ templ.SafeURL("/imoveis/" + imovel.Slug) }
		class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl border border-gray-100 transition-all duration-300"
	>
		<div class="relative overflow-hidden h-52">
			if thumbURL != "" {
				<img
					src={ thumbURL }
					alt={ imovel.Titulo }
					class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
				/>
			} else {
				<div class="w-full h-full bg-gray-100 flex items-center justify-center text-gray-400 text-sm">
					Sem foto
				</div>
			}
			<div class="absolute top-3 left-3 flex gap-2">
				if imovel.Finalidade == "venda" {
					<span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-teal-600 text-white">Venda</span>
				} else if imovel.Finalidade == "aluguel" {
					<span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-orange-500 text-white">Aluguel</span>
				}
				if imovel.Destaque {
					<span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-yellow-400 text-yellow-900">★ Destaque</span>
				}
			</div>
		</div>
		<div class="p-5">
			<p class="text-xs text-gray-400 uppercase tracking-wider mb-1.5">
				{ imovel.Tipo } · { imovel.Bairro }, { imovel.Cidade }
			</p>
			<h3 class="font-semibold text-gray-900 mb-3 group-hover:text-teal-600 transition-colors leading-snug">
				{ imovel.Titulo }
			</h3>
			<div class="flex flex-wrap gap-3 text-gray-500 text-sm mb-4">
				if imovel.AreaM2 > 0 {
					<span>◻ { fmt.Sprintf("%.0f", imovel.AreaM2) }m²</span>
				}
				if imovel.Quartos > 0 {
					<span>🛏 { fmt.Sprintf("%d", imovel.Quartos) }</span>
				}
				if imovel.Banheiros > 0 {
					<span>🚿 { fmt.Sprintf("%d", imovel.Banheiros) }</span>
				}
				if imovel.VagasGaragem > 0 {
					<span>🚗 { fmt.Sprintf("%d", imovel.VagasGaragem) }</span>
				}
			</div>
			<div class="flex items-center justify-between border-t border-gray-100 pt-3">
				<p class="text-teal-700 font-bold text-lg">
					if imovel.Finalidade == "aluguel" {
						R$ { fmt.Sprintf("%.0f", imovel.Preco) }/mês
					} else {
						R$ { fmt.Sprintf("%.0f", imovel.Preco) }
					}
				</p>
				<span class="text-xs text-teal-500 font-medium group-hover:underline">Ver detalhes →</span>
			</div>
		</div>
	</a>
}
